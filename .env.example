# AgriGuard environment variables
# Copy this file to .env and fill in real values: cp .env.example .env
# .env is gitignored; never commit real secrets.

# [Required] Django secret key. Generate a random value for production.
SECRET_KEY=django-insecure-change-me

# Comma-separated Django hostnames. Use '*' only for local demos.
ALLOWED_HOSTS=*

# [Required] Database connection string. Docker Compose uses the default below.
DATABASE_URL=postgis://postgres:postgres@db:5432/agri_guard_db

# [Required] Celery broker and result backend. Docker Compose uses Redis.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# [Local no-Docker demo only] Uncomment to run without Redis.
# CELERY_TASK_ALWAYS_EAGER=True
# CHANNEL_LAYER_BACKEND=memory

# [Optional] OpenAI API key. If empty, AI features fall back to mock mode.
OPENAI_API_KEY=

# [Optional] Twilio SMS credentials. If empty, SMS alerts fall back to mock mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# [Optional] Web3 blockchain payout configuration. If empty, claims stay PENDING/simulated.
# SMART_CONTRACT_ADDRESS is treated as the ERC-20 payout token address (for example
# a USDC contract) by the live settlement path.
WEB3_PROVIDER_URI=
WEB3_PRIVATE_KEY=
SMART_CONTRACT_ADDRESS=
# ERC-20 token decimals used when converting USD payout amounts to on-chain units.
WEB3_PAYOUT_DECIMALS=6

# [Optional] Windows local development only. Point to osgeo DLLs when not using Docker.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
