# AgriGuard frontend environment variables
# Copy this file to .env and fill in real values. Vite only exposes variables prefixed with VITE_.

# Mapbox access token used by MapView (react-map-gl/mapbox). Get one at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your-mapbox-token-here

# Backend API base URL used by Login/Register/Dashboard.
# Local dev: http://127.0.0.1:8000/api
# Docker demo (browser -> host port): http://localhost:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional WebSocket base URL. Defaults to VITE_API_BASE_URL with http->ws and /api removed.
# Example local dev: ws://127.0.0.1:8000/ws/alerts/
# Example Docker demo: ws://localhost:8000/ws/alerts/
VITE_WS_BASE_URL=
